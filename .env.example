# Headwind MDM Community configuration.
# Copy this file to .env and replace all public defaults before deployment.
# Never commit .env: it contains database, TLS and SMTP credentials.

# PostgreSQL database used by Headwind MDM.
SQL_BASE=hmdm
SQL_USER=hmdm
SQL_PASS=Ch@nGeMe

# Public address and administrator account.
# BASE_DOMAIN is also used as the public base for locally served APK files.
ADMIN_EMAIL=admin@example.com
BASE_DOMAIN=your-domain.com
# Optional non-standard public port, for example 8443.
BASE_PORT=
# Optional URL prefix, with or without a leading slash.
BASE_PATH=

# Set true only when the generated configuration or initial catalog must be
# recreated. Unset it after setup to preserve panel configuration changes.
FORCE_RECONFIGURE=

# Public protocol used by the panel and generated application URLs.
PROTOCOL=https
# Secret shared by the panel and enrolled Android clients.
SHARED_SECRET=changeme-C3z9vi54

# Community edition defaults.
HMDM_VARIANT=os
# APK variant used in hmdm-<CLIENT_VERSION>-<CLIENT_VARIANT>.apk.
CLIENT_VARIANT=os
# Leave empty for the Community download. Premium credentials must stay private.
DOWNLOAD_CREDENTIALS=
# WAR file downloaded during container startup.
HMDM_URL=https://h-mdm.com/files/hmdm-7.03.3-os.war
# Android client version. The matching APK is downloaded from h-mdm.com/files/.
# It is then stored locally and published through BASE_DOMAIN/files/.
CLIENT_VERSION=6.40

# HTTPS certificate configuration.
# With HTTPS_LETSENCRYPT=true, certbot creates these files under volumes/letsencrypt.
HTTPS_LETSENCRYPT=true
HTTPS_CERT=cert.pem
HTTPS_FULLCHAIN=fullchain.pem
HTTPS_PRIVKEY=privkey.pem

# Optional SMTP settings for password recovery emails.
SMTP_HOST=
SMTP_PORT=
SMTP_SSL=0
SMTP_STARTTLS=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
